{
  "manifest_version": 3,
  "name": "GSC URL Inspection Helper",
  "version": "0.2.1",
  "description": "Batch inspect URLs in Google Search Console or submit URLs to Brave Search.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "GSC URL Inspection Helper",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "activeTab",
    "debugger",
    "scripting",
    "sidePanel",
    "tabs",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://search.google.com/search-console/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://search.brave.com/submit-url*"
      ],
      "js": [
        "brave-content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
